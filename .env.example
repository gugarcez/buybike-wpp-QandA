# Chave da Anthropic — a Cláudia usa Haiku pra responder. Copie do .env.local do app.
ANTHROPIC_API_KEY=

# Protege a página de QR/status (/?token=...). Em produção, SEMPRE defina.
ADMIN_TOKEN=

# Liga/desliga as respostas automáticas (kill-switch). default: true
CLAUDIA_ENABLED=true

# Cooldown anti-flood por contato, em ms. default: 15000
COOLDOWN_MS=15000

# Porta. Railway/Render injetam PORT automaticamente. Local: default 3838.
# PORT=3838

# Caminho do Chromium. No Docker já vem setado (/usr/bin/chromium).
# Local no Mac cai pro Chrome do sistema automaticamente.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Pasta da sessão do WhatsApp Web. No Railway/Render aponte pro volume persistente.
# WWEB_AUTH=/app/.wwebjs_auth

# ─── Prospecção Hub4 (grupo → anúncio pré-montado → push pro operador) ──────────
# Modo de contato com o vendedor:
#   push (padrão) → NÃO manda pro vendedor. Cria o rascunho, gera um link wa.me
#                   pré-preenchido e AVISA o operador (você). Você toca o link no
#                   seu WhatsApp e envia — envio humano, do seu número.
#   auto (legado) → dispara a DM direto pro vendedor pelo número do bot.
PROSPECCAO_MODO=push

# Seu número pessoal (o operador) que recebe o push no modo 'push'. OBRIGATÓRIO
# nesse modo. Informe SEMPRE com código do país (não força Brasil, pode ser intl).
# Ex.: 5511999998888 (BR) ou 34627201639 (ES, +34 627 201 639).
OPERADOR_NUMERO=

# Seu nome, usado na mensagem pessoal ("Sou o ___, da Buybike"). default: Gustavo
OPERADOR_NOME=Gustavo


# Identifica o grupo-alvo pelo NOME (regex, case-insensitive). Assim funciona em
# vários grupos Hub4 ("HUB4 - Grupo 1", "Grupo 2"…) e em vários números sem
# configurar JID. default: hub\s*-?\s*4 (casa "Hub4", "HUB 4", "hub-4"…).
# GRUPO_ALVO_REGEX=hub\s*-?\s*4

# Override OPCIONAL: lista de JIDs (separados por vírgula) sempre tratados como alvo,
# além do match por nome. Descubra os JIDs em GET /api/grupos. Vazio = só usa a regex.
# OBRIGATÓRIO quando o store do whatsapp-web.js está quebrado (msg.getChat() → erro
# 'r'): sem ele o match por NOME não resolve e nenhuma mensagem de grupo é vista.
# Nesse cenário os JIDs aparecem no log: "erro resolvendo grupo <jid>: r".
GRUPO_ALVO_ID=

# Blocklist ESTÁTICA de admins (telefones separados por vírgula) — nunca viram prospect.
# Fallback pra quando os admins do grupo não resolvem (store quebrado). Sem ela E sem
# admins dinâmicos, todo lead é descartado (fail-closed). Admin Hub4: Lucas 5511998592280.
ADMINS_BLOCK=

# Liga a prospecção. default: false (desligada). Só ligue depois de validar a extração.
PROSPECCAO_ENABLED=false

# Modo seguro: NÃO cria anúncio nem manda DM — só loga o que faria. default: true.
# Ponha false só quando estiver pronto pra disparar de verdade.
PROSPECCAO_DRY_RUN=true

# Base da API do app Buybike (onde o anúncio é criado). default: https://buybike.com.br
# BUYBIKE_API_URL=https://buybike.com.br

# Bearer secret pro endpoint /api/admin/hub4-import (mesmo valor do app).
ADMIN_SECRET=

# Debounce do pareamento foto(s)+card, em ms. default: 30000 (30s).
# PROSPECCAO_DEBOUNCE_MS=30000
